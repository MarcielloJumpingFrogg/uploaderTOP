<!DOCTYPE html>

<% if(popUp.title) { %>
<div class="popUp" >
<div class="closingButton absolute right-5 top-2">
  <button  onclick="this.parentElement.parentElement.classList.remove('popUp');this.parentElement.classList.toggle('hidden')">X</button>
  </div>
  <h1 ><%= popUp.title %></h1>
  <p id="shareLink" class="link"><%= popUp.text %></p>
  <button onclick="copyLink()">
    <img src="/static/copy.svg" width="30px" />
  </button>

</div>

<script>
  function copyLink() {
    var copyText = document.getElementById("shareLink");
    navigator.clipboard.writeText(copyText.innerText);
    copyText.classList.add("bg-red-200");
  }
</script>

<%}%>
