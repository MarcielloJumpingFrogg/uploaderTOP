{
  "name": "secondexe",
  "version": "1.0.0",
  "description": "",
  "main": "app.ts",
  "scripts": {
    "test": "NODE_ENV=test prisma migrate reset --force && prisma migrate dev --name test && prisma generate && vitest",
    "test:vb": "NODE_ENV=test prisma migrate deploy && prisma generate && vitest dev --coverage",
    "dev": "NODE_ENV=docker tsx app.ts",
    "local": "nodemon --watch './' --ext 'ts, json, ejs' --exec 'NODE_ENV=local tsx --watch app.ts'",
    "docker": "prisma migrate dev --name init && prisma generate && NODE_ENV=docker tsx app.ts ",
    "migrate": "prisma migrate dev --name init && prisma generate",
    "migrate_local": "NODE_ENV=local prisma migrate deploy && prisma generate",
    "tailwindcss": "npx @tailwindcss/cli -i ./static/style.css -o ./static/output.css --watch",
    "reset": "prisma migrate reset --force && tsx deleteUploads.ts && nodemon --watch './' --ext 'ts, json, ejs' --exec 'NODE_ENV=local tsx --watch app.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@quixo3/prisma-session-store": "^3.1.21",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/cli": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pg-pool": "^3.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supabase": "^2.117.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
