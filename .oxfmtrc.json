{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [],
  "printWidth": 80,
  "useTabs": false,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 10
  },
  "singleQuote": true,

  "associations": [
    {
      "files": ["*.ejs"],
      "language": "html"
    }
  ]
}
