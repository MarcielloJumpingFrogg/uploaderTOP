<!DOCTYPE html>
<div class="bottomContainer flex flex-col bg-gray-100 min-h-full m-3 p-2 rounded-2xl">

  <div class="listContainer flex flex-wrap justify-center min-h-full">
    <% if(files.length == 0 ) { %>
    <p>No files</p>
    <%} else {
      let loadedFolder=[]
      files.forEach(file=> {
        let match = true;
        let finalFileType = file.type;
        let finalName=file.name %>

    <div class="itemContainer bgAmber">
      <div>
        <button class="menuButton" onclick="toggleOptions(this, '.editFile')">
          <img
            src="/static/menuLines.svg"
            alt="menuButton"
            width="20px"
            height="20px"
          />
        </button>
        <%- include("editFile", {finalName: finalName, path: path, finalFileType: finalFileType, file: file}) %>
      </div>
      <% const fileClass = "item element" + file.id  %>
      <% let result; if(finalFileType === "folder" || finalFileType === "folder_alt") {result = 'travelFolder(this)'} else {result = ' '} %>
      <div
        class="<%= fileClass %>"
        onclick="<%=result%>" >
        <% const imageSource = "/static/resources/" + finalFileType + ".svg" %>
        <img src="<%= imageSource %>" class="w-20 self-center" />
        <p><%= finalName %></p>
      <form class="hiddenForm" action="/account/folder" method="POST">
          <% const pathForThisLink = path.replaceAll("/", "@") %>
            <input type="hidden" name="_sessionId" value="<%=file.sessionId%>" />
            <input type="hidden" name="_location" value="<%=path%>" />
            <input type="hidden" name="_name" value="<%=finalName%>" />
            <a class="travelLink" href="/account/<%=file.sessionId%>/<%=pathForThisLink%>@<%=finalName%>" hidden></a>

            <button class="submitTravel" type="submit" hidden></button>
      </form>
      </div>
    </div>
    <%})}%>
  </div>
</div>

<script>
  function toggleOptions(element, className) {
    const editFile = element.parentElement.querySelector(className);
    editFile.classList.toggle("hidden");
    editFile.classList.toggle("window");
  }

  function travelFolder(element) {
    if (element.parentElement.classList.contains("pressed")) {
      const hiddenForm =element.querySelector(".hiddenForm")
      hiddenForm.querySelector(".travelLink").click()
    }
  }

  function selected() {
    const elements = document.querySelectorAll(".item");
    elements.forEach((e) => {
      const parentE = e.parentElement;
      e.addEventListener("click", function () {
        if (parentE.classList.contains("pressed")) {
          parentE.classList.remove("pressed");
        } else {
          const prev = document.querySelectorAll(".pressed");
          prev.forEach((parentE) => {
            parentE.classList.remove("pressed");
          });
          parentE.classList.add("pressed");

        }
      });
    });
  }
  selected();
</script>
