// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id      String @id
  sid     String @unique
  data    String
  expiresAt  DateTime
}

model Users {
  id       String    @id @default(uuid())
  username String    @unique
  password String
  fileList Files[]
  avatarVersion Int  @default(0)
  sharedFiles      ShareSession[]
  receivedFiles    SharedFiles[]
}

model Files {
  id           String  @id @default(uuid())
  ownerId      String
  parentFolder String
  fileName     String
  type         String
  size         String  @default("-")
  updated_at   DateTime @default(now())
  created_at   DateTime @default(now())
  referenceOwnerId       Users   @relation(fields: [ownerId], references: [id])
  sessionId    ShareSession[]
}

model ShareSession {
  id            String @id @default(uuid())
  originalUser  String
  originalFile  String 
  expiration    DateTime @default(now())
  edit          Boolean
  sharedFiles   SharedFiles[]
  originalFileRelation   Files @relation(fields: [originalFile], references: [id])
  originalUserRelation   Users @relation(fields: [originalUser], references: [id])
}

model SharedFiles {
  id            String @id @default(uuid())
  destinationUser String
  userSharedWith  Users @relation(fields: [destinationUser], references: [id])
  sessionId       String
  session         ShareSession @relation(fields: [sessionId], references: [id])
}
