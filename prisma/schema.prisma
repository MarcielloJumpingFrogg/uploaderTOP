// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id      String @id
  sid     String @unique
  data    String
  expiresAt  DateTime
}

model Users { 
  id       String    @id @default(uuid()) 
  username String    @unique
  password String 
  fileList Files[]
  avatarVersion Int  @default(0)
  sharedFiles      ShareSession[]
  receivedFiles    SharedFiles[]
} 

model Files {
  id          String  @id @default(uuid())
  fileId      String
  path        String  
  fileName    String  //not sure if it's usefull if i already have the id but okay, maybe for the locally saved files
  mimetype    String
  size        Int
  uploadTime  DateTime @default(now())
  currentUser String
  ownerId     String
  owner       Users   @relation(fields: [ownerId], references: [id])
}

model ShareSession {
  id            String @id @default(uuid())
  originalUser  String
  creator       Users @relation(fields: [originalUser], references: [id])
  expiration    DateTime @default(now())
  filePath      String
  type          String
  edit          Boolean
  sharedFiles   SharedFiles[]
}

model SharedFiles {
  id            String @id @default(uuid())
  originalUser  String
  destinationUser String  
  userSharedWith  Users @relation(fields: [destinationUser], references: [id])
  expiration      DateTime
  sessionId       String
  session         ShareSession @relation(fields: [sessionId], references: [id])
}
