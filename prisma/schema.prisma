// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id      String @id
  sid     String @unique
  data    String
  expiresAt  DateTime
}

model Users {
  id                 String         @id @default(uuid())
  username           String         @unique
  password           String
  avatarVersion      Int            @default(0)
  sharedFiles        ShareSession[]
  receivedFiles      SharedFiles[]
  fileList           Items[]
}

model Items {
  id                        String         @id @default(uuid())
  ownerId                   String
  referenceOwnerId          Users          @relation(fields: [ownerId], references: [id])
  parentFolderId            String?
  fileName                  String
  type                      Type           @default(FILE)
  fileType                  String
  size                      String         @default("-")
  updated_at                DateTime       @default(now())
  created_at                DateTime       @default(now())
  sessionId                 ShareSession[]
  sharedFiles               SharedFiles[]
  upperFolderId             String?
  insideFolder              Items? @relation("FolderHierarchy", fields: [upperFolderId], references: [id])
  subFolders                Items[] @relation("FolderHierarchy")
}

model ShareSession {
  id                      String @id @default(uuid())
  originalUser            String
  originalFile            String 
  expiration              DateTime @default(now())
  edit                    Boolean
  sharedFiles             SharedFiles[]
  originalFileRelation    Items @relation(fields: [originalFile], references: [id])
  originalUserRelation    Users @relation(fields: [originalUser], references: [id])
}

model SharedFiles {
  id            String @id @default(uuid())
  destinationUser String
  userSharedWith  Users @relation(fields: [destinationUser], references: [id])
  sessionId       String
  session         ShareSession @relation(fields: [sessionId], references: [id])
  parentFolder    String
  originalFile    String
  ogFileRelation  Items @relation(fields: [originalFile], references: [id])
}


enum Type {
  FILE
  FOLDER
}
