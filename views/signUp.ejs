<!DOCTYPE html>

<%- include("partials/head", {title: "Create User"}) %>


<a href="/login">Login</a>

<h1>PLEASE FOR FUCK SAKE REMOVE NOVALIDATE BEFORE YOU WASTE TIME</h1>
<%- include("partials/errors") %>
<form method=POST action="/signUp" novalidate>
  <H1>Sign Up</H1>
  <label for="username">User Name:</label>
  <input type="text" name="username" id="username" required minlength=3 maxlength=15/>
  <label for="password">Password:</label>
  <input type="password" name="password" id="password" pattern="^(?=(.*[a-z]){1,})(?=(.*[A-Z]){1,})(?=(.*[0-9]){1,})(?=(.*[!-\/]|[:-@]){1,}).{8,}$" required />
  <button type="submit">Submit</button>
</form>

