<!DOCTYPE html>

<div class="bottomContainer flex flex-col " >
  <%
  let back = "/account/Home"
  let buttonClass = "disabled"
  let text = " <= Back"
  if(path.length > 1) {
    for (let i = 1; i < path.length - 1; i++){
      back += "@" + path[i]
    }
      buttonClass = "inFolder"
  }
  if(buttonClass == "inFolder") { %>
<button class="buttonClass" onClick="location.href = '<%= back %>'"><%= text %></button>
<% } else { %>
    <button class="buttonClass "><p class="<%= buttonClass %> "><%= text %></p></button>
<% } %>

<div class="listContainer flex flex-wrap justify-center">
  <% if(files.length == 0 ) { %>
  <p>No files</p>
      <%} else { %>

  <%
  let loadedFolder=[]
  files.forEach(file=> {
  let match = true
  let finalFileType = file.type
  let finalName=file.name
  let skipping = false
    for(let i = 0 ; i < file.path.length; i++) {
      if(file.path[i] !== path[i]  ){
        match = false;
        finalFileType = "folder";
        finalName = file.path[i];
      
        if(!loadedFolder.includes(file.path[i])) {
          loadedFolder.push(file.path[i])
          break
        } else {
          skipping = true;
          break;
        }
      } 
    }
    if(!skipping ){
    %>
        <div class="itemContainer element<%= file.id %>" id="element<%= file.id %>"  
          data-finalname = "<%= finalName %>"
          data-path = "<%=path%>"
          onclick="
          <% if(finalFileType=="folder" || finalFileType=="folder_alt") { 
          %> travelFolder(this ) <% } else { %> toggleShow(this) <% } %>" >
    <img src=<%= "/static/resources/" + finalFileType + ".svg" %> class="w-20 self-center"  />
    <p><%= finalName %></p>
    <div class="onClickAction hidden">
      <%
      if(finalFileType == "folder" || finalFileType == "folder_alt") { %>
      
      <% } else { %>
        <p>To Implement</p>
      <% }
      %>
    </div>
  </div>
  <%}})
  %>
  <%}%>

</div>
</div>

<script>

  function toggleShow(element) {
    const children = element.children
    for(let i = 0; i < children.length; i++) {
      if(children[i].classList.contains("onClickAction")){
        children[i].classList.toggle("hidden")
        children[i].classList.toggle("show")
      }
    }
  }

  function travelFolder(element) {
    const path = element.dataset.path.split(",")
    const finalName = element.dataset.finalname
    let currentPath = "/account/Home"
    for(let i = 1; i < path.length; i++) {
    currentPath +=  "@" + path[i]
    }
    if(element.classList.contains("pressed")) {
      location.href = currentPath + "@" + finalName;
    }   
  }
  
  function selected() {

  const elements = document.querySelectorAll(".itemContainer")
  elements.forEach(e => {
    e.addEventListener("click", function() {
      if(e.classList.contains("pressed")) {
          e.classList.remove("pressed")
        } else {
      const prev = document.querySelectorAll(".pressed")
      prev.forEach(e => {e.classList.remove("pressed")})
      e.classList.add("pressed")
        }
    })
  })

 }
  selected()


</script>
