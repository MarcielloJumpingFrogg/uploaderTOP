<!DOCTYPE html>

<div class="editFile hidden">
  <form action="/account/delete" method="POST">
    <input type="hidden" name="_method" value="DELETE" />
    <input type="hidden" name="_location" value="<%=path%>" />
    <input type="hidden" name="_name" value="<%=finalName%>" />
    <input type="hidden" name="_type" value="<%=finalFileType%>" />
    <button type="submit" value="Delete">Delete</button>
  </form>
  <form action="/account/rename" method="POST" >
    <input type="hidden" name="_method" value="RENAME" />
    <input type="hidden" name="_location" value="<%=path%>" />
    <input type="hidden" name="_name" value="<%=finalName%>" />
    <input type="hidden" name="_type" value="<%=finalFileType%>" />
    <label for="newName">New Name:</label>
    <input type="text" name="newName" />
    <button type="submit" value="Rename">Rename</button>
  </form>

  <div>
    <button onclick="toggleOptions(this, '.infos')">Info</button>
    <div class="infos hidden">
      <p><b>File Name: </b><%=file.name%></p>
      <p><b>File Size: </b><%=file.size%></p>
      <p><b>File Upload Time: </b><%=file.created_at%></p>
    </div>
  </div>
  
  <form action="/account/download" method="POST">
     <input type="hidden" name="_method" value="DOWNLOAD" />
    <input type="hidden" name="_location" value="<%=path%>" />
    <input type="hidden" name="_name" value="<%=finalName%>" />
    <input type="hidden" name="_id" value="<%= file.id %>" />
    <button type="submit">Download</button>
  </form>
</div>
