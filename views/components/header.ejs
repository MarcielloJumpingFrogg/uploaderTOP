<!DOCTYPE html>

<header class="bg-royalBlue text-white flex h-30 justify-between align-middle p-5 rounded-b-2xl mb-5 "> 
  <a class="text-3xl self-center " href="/account" >Welcome Back <span class="underline italic "><%= user.username %></span></a
  >
  <div class="imageContainer">
    <img
      src="<%= avatar %>"
      class="size-20 rounded-full border-4 border-white"
      onclick="toggleVisibility()"
    />
    <div id="user_modal" class="hidden user_modal">
      <div class="user_modal_header flex w-11 rounded-b-full">
        <img
          src="<%= avatar %>"
          class="size-20"
          onclick="toggleVisibility()"
        />
        <span class="username"><%= user.username %></span>
      </div>
      <div class="user_modal_actions">
        <hr class="solid" />
        <form
          action="/account/avatar"
          method="post"
          enctype="multipart/form-data"
        >
          <label for="AvatarFile">Upload An Avatar: </label>
          <input type="file" name="avatar" id="AvatarFile" required />
          <br />
          <button type="submit" class="submit-button">Confirm</button>
        </form>
      </div>
      <div class="user_modal_footer">
        <hr class="solid" />
        <a href="/log-out" class="log-out">LOG OUT</a>
      </div>
    </div>
  </div>
</header>
