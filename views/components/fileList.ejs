<!DOCTYPE html>

<div class="listContainer flex flex-wrap justify-center">
  <% if(files.length == 0 ) { %>
  <p>No files</p>
  <%} else {%>
    <%

  if(path.length > 1 ) {files.push({id: 9999999999 ,path: [".."], type:"folder", name: ".."})}
  files.forEach(file=> {
  let match = true
  let finalFileType = file.type
  let finalName=file.name
  let loadedFolder=[]
    for(let i = 0 ; i < file.path.length; i++) {
      if(file.path[i] !== path[i]){
        match = false;
        finalFileType = "folder";
        finalName = file.path[i];
        
        loadedFolder.push(file.path[i])
        break;
      }
    }
    %>
    <div class="itemContainer element<%= file.id %>" id="element<%= file.id %>" onclick="myFunction(this)" >
    <img src=<%= "/static/resources/" + finalFileType + ".svg" %> class="w-20 self-center"  />
    <p><%= finalName %></p>
    <div class="onClickAction hidden">
      <%
      if(finalFileType == "folder" || finalFileType == "folder_alt") { %>
      <% let currentPath = "/account/Home"
        for(let i = 1; i < path.length; i++) {
        currentPath +=  "@" + path[i]
        }
        if(finalName === "..") {
        let splitted = path.split("@")
        let back = "/account"
        for(let j = 0; j < splitted.length - 1; j++ ){
          back += splitted[j]
          } %>
            <a href=<%= back %> >..</a>
<%} else {
      %>
        <a href=<%= currentPath + "@" + finalName%> >aia</a>
<% }} else { %>
        <p>To Implement</p>
      <% }
      %>
    </div>
  </div>
  <%})
  %>
  <%}%>

</div>

<script>
  function myFunction(element) {
    const children = element.children
    for(let i = 0; i < children.length; i++) {
      if(children[i].classList.contains("onClickAction")){
        children[i].classList.toggle("hidden")
        children[i].classList.toggle("show")
      }
    }
  }
</script>
