<!DOCTYPE html>

<div class="listContainer flex flex-wrap justify-center">
<% const user = {id: 1, username: "123"} %>
<% const files=[{usrFileName:"123@Home/quack", mimetype:"text/plain"}, {usrFileName:"123@Home/pio", mimetype:"text/plain"}] %>
  <% if(files.length == 0 ) { %>
  <p>No files</p>
  <%} else {%>
  <% console.log("somethign") %>
  <% files.forEach(element => { %>
  <% let filetype %>
  <% const extensions = [ 'ae','avi', 'css','csv', 'excel','file','html','illustrator', 'jpeg','mpeg', 'ms-powerpoint', 'other', 'pdf','photoshop','png','quicktime', 'rar','txt', 'wave','word', 'x-eps','zip'];
  <% const mimetype = element.mimetype? element.mimetype.split("/"): []; let first = mimetype[0]; let second = mimetype[1]; %>
  <% if(first == "text") {filetype = "txt"} %>
  <% if(second =="octet-stream") {filetype="other"} %>
  <% const splitElement = second? second.split("."):[]; console.log("splitElement of element:", element , splitElement)%>
  <% for(let i = 0; i < splitElement.length; i++) {%>
    <%if(extensions.includes(splitElement[i])) {filetype=splitElement[i]; break}%>
    <%}%>
  <% if(!filetype) {filetype="other"}%>
  <% if(element.usrFileName !== user.username+"@Home/avatar") {%>
  <% const loadedFolders = [] %>
  <% const fileName = element.usrFileName; let finalName; let finalImage; let currentFolder="Home" %>
  <% const folders=fileName.split("/") ; if(folders.length > 2) { %>
        <% for(let i=1; i<folders.length-1; i++) { %>
          <% if(!loadedFolders.includes(folders[i])) { %>
            <%loadedFolders.push(folders[i])%>
            <%console.log("loaded folders: ", loadedFolders, "folders:", folders[i])%>
      <%}}}%>
  <div class="itemContainer flex flex-col list-none size-50 bg-amber-100 p-5 m-5 rounded-2xl border-1 text-center justify-center">
    <img class="w-20 self-center" src=<%= "/static/resources/"+filetype+".svg" %>/>
    <li class="truncate "><%= fileName.split("@")[1] %></li>
  </div>
  <% } %>
  <% })%>
  <%}%>

</div>
